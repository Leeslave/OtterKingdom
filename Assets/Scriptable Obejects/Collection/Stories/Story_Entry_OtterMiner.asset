  - _cut: 0
    _text: "\uae61! \uae61! {\uc774\ub984}\ub2d8, \uc774 \uc18c\ub9ac \ub4e4\ub824\uc694? \ub3cc\uc774 \ub300\ub2f5\ud558\ub294 \uc18c\ub9ac\uc608\uc694."
