  - _cut: 0
    _text: "\uc788\uc796\uc544\uc694, {\uc774\ub984}\ub2d8! \uadf8\uac70 \ub4e4\uc5c8\uc5b4\uc694? \uc0c1\uc810\uc5d0 \uc0c8 \ubb3c\uac74 \ub4e4\uc5b4\uc628\ub300\uc694!"
