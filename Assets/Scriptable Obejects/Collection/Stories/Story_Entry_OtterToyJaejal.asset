    _text: "\uacf5\ub3d9 \uc2dd\ud0c1\uc5d0 \uc549\uc73c\uba74\uc694, \ub9c8\uc744 \uc18c\uc2dd\uc774 \ub2e4 \ub4e4\ub824\uc694."
