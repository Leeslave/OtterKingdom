  _lines:
  - _cut: 0
    _text: "\uc9e4\ub791\uc9e4\ub791~ \uc774 \uc18c\ub9ac \uc88b\uc8e0? \uc624\ub298 \uccab \uc190\ub2d8\uc740 {\uc774\ub984}\ub2d8\uc774\uc5d0\uc694!"
  - _cut: 1
    _text: "\uc88b\uc740 \ubb3c\uac74\uc740 \uc81c\uac12\uc5d0! \u2026\ub77c\uace0 \ud558\uace0 \uc2f6\uc9c0\ub9cc {\uc774\ub984}\ub2d8\uc740 \ub2e8\uace8\uc774\ub2c8\uae4c\uc694."
